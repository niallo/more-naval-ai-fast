diff --git a/apps/oc4core/SaveFile.cpp b/apps/oc4core/SaveFile.cpp
index cd2eed2..4d1f6b7 100644
--- a/apps/oc4core/SaveFile.cpp
+++ b/apps/oc4core/SaveFile.cpp
@@ -175,7 +175,23 @@ namespace oc4::host
 		}
 		s.gameData = inflateStream(compressed);
 		s.pythonData = r.str();
-		r.bytes(kTrailerZeros);
+		r.need(kTrailerZeros + sizeof(int));
+		// Older saves can store turn-summary records between Python data and the trailing checksum.
+		constexpr size_t checksumSize = 32;
+		const size_t checksumOffset = file.size() >= sizeof(int) + checksumSize
+			? file.size() - sizeof(int) - checksumSize : 0;
+		if (checksumOffset >= r.p + kTrailerZeros)
+		{
+			Reader trailer{ file, checksumOffset };
+			if (trailer.i32() == checksumSize)
+				r.p = checksumOffset;
+			else
+				r.p += kTrailerZeros;
+		}
+		else
+		{
+			r.p += kTrailerZeros;
+		}
 		s.md5 = r.str();
 		return s;
 	}
